# ============================================================
# B2B Stationery OMS — Production Environment Template
# Copy this file to .env on your server and fill in live secrets
# ============================================================

# --- Database Connection ---
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL="postgresql://db_user:strong_password@localhost:5432/stationery_oms_production"

# --- Security & JWT Secrets ---
# Generate using terminal command: openssl rand -hex 64
JWT_SECRET="replace-with-cryptographically-secure-64-byte-hex-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-another-secure-64-byte-hex-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Server & CORS ---
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed frontend domains (e.g. customer website and admin web URL)
CORS_ORIGIN="https://your-customer-portal.com,https://your-admin-portal.com,app://."

# --- Initial Admin Account (for running db:seed) ---
ADMIN_EMAIL="admin@yourclientcompany.com"
ADMIN_PASSWORD="SecureAdminPassword@2026!"

# --- Cloudinary (for Product Image Storage) ---
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- SMTP Email Configuration (Nodemailer) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="orders@yourclientcompany.com"
SMTP_PASS="your-app-specific-password-or-smtp-key"
SHOP_OWNER_EMAIL="owner@yourclientcompany.com"
SHOP_NAME="Client Stationery Shop Name"
