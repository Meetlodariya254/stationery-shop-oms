# ============================================================
# B2B Stationery OMS — Production Environment Template
# Copy this file to .env on your server and fill in live secrets
# ============================================================

# --- Database Connection ---
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL="postgresql://db_user:strong_password@localhost:5432/stationery_oms_production"

# --- Security & JWT Secrets ---
# Generate using terminal command: openssl rand -hex 64
JWT_SECRET="replace-with-cryptographically-secure-64-byte-hex-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-another-secure-64-byte-hex-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Server & CORS ---
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed frontend domains (e.g. customer website and admin web URL)
CORS_ORIGIN="https://your-customer-portal.com,https://your-admin-portal.com,app://."

# --- Initial Admin Account (for running db:seed) ---
ADMIN_EMAIL="admin@yourclientcompany.com"
ADMIN_PASSWORD="SecureAdminPassword@2026!"

# --- Cloudinary (for Product Image Storage) ---
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# --- SMTP Email Configuration (Nodemailer) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="orders@yourclientcompany.com"
SMTP_PASS="your-app-specific-password-or-smtp-key"
SHOP_OWNER_EMAIL="owner@yourclientcompany.com"
SHOP_NAME="Client Stationery Shop Name"

# --- Rate Limiting Thresholds ---
# Stricter limits for authentication endpoints (per-IP and per-account exponential backoff)
RATE_LIMIT_AUTH_WINDOW_MS=900000        # 15 minutes window
RATE_LIMIT_AUTH_MAX_IP=20               # Max attempts per IP per window before backoff delay occurs
RATE_LIMIT_AUTH_MAX_ACCOUNT=10          # Max attempts per account (email) per window before backoff delay occurs
RATE_LIMIT_AUTH_BASE_DELAY_MS=1000      # Base exponential backoff delay (1 second)
RATE_LIMIT_AUTH_MAX_DELAY_MS=60000      # Maximum exponential backoff delay (60 seconds)
RATE_LIMIT_AUTH_CEILING_IP=100          # Hard safety ceiling per IP during active backoff (returns 429)
RATE_LIMIT_AUTH_CEILING_ACCOUNT=50      # Hard safety ceiling per account during active backoff (returns 429)

# Moderate limits for public endpoints
RATE_LIMIT_PUBLIC_WINDOW_MS=900000      # 15 minutes window
RATE_LIMIT_PUBLIC_MAX=200               # Max requests per window per IP

# Looser limits for authenticated endpoints
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000 # 15 minutes window
RATE_LIMIT_AUTHENTICATED_MAX=1000         # Max requests per window per authenticated user

